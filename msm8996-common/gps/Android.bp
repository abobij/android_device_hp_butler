cc_binary {
    name: "android.hardware.gnss@1.0-service.hp",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.gnss@1.0-service.hp.rc"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.gnss@1.0",
        "libdl",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
    ],
}
