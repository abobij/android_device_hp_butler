cc_binary {
    name: "android.hardware.usb@1.0-service.hp",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.usb@1.0-service.hp.rc"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "service.cpp",
        "Usb.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
        "android.hardware.usb@1.0",
    ],
}
