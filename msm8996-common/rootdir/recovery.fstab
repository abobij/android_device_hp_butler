# Partition, mount point, filesystem, mount flags, fs_mgr flags
/dev/block/platform/soc/7464900.sdhci/by-name/system    /system  ext4  ro,discard                            wait,first_stage_mount
/dev/block/platform/soc/7464900.sdhci/by-name/cache     /cache   ext4  nosuid,nodev                          wait,check,nofail
/dev/block/platform/soc/7464900.sdhci/by-name/userdata  /data    ext4  nosuid,nodev,noauto_da_alloc,discard  wait,check,latemount,encryptable=footer
/dev/block/platform/soc/7464900.sdhci/by-name/boot      /boot    emmc  defaults                              defaults
/dev/block/platform/soc/7464900.sdhci/by-name/recovery  /recovery emmc defaults                              defaults
/dev/block/platform/soc/7464900.sdhci/by-name/misc      /misc    emmc  defaults                              defaults
