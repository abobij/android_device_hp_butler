import /vendor/etc/init/hw/init.hp.usb.rc

on fs
    mount_all /vendor/etc/fstab.qcom --early

on post-fs
    symlink /dev/block/platform/soc/7464900.sdhci /dev/block/bootdevice
    mount vfat /dev/block/platform/soc/7464900.sdhci/by-name/modem /firmware ro shortname=lower,uid=1000,gid=1026,dmask=227,fmask=337,context=u:object_r:vendor_file:s0
    mount vfat /dev/block/bootdevice/by-name/bluetooth /bt_firmware ro nosuid nodev noexec shortname=lower,uid=1002,gid=1002,dmask=227,fmask=337,context=u:object_r:vendor_file:s0
    mount ext4 /dev/block/bootdevice/by-name/persist /persist noatime nosuid nodev barrier=1
    write /sys/kernel/boot_adsp/boot 1
    write /sys/kernel/boot_slpi/boot 1
    wait /dev/snd/controlC0 5
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}

on boot
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/device/extldo
    chmod 0660 /sys/class/rfkill/rfkill0/device/extldo
    chown system system /sys/class/leds/red/blink
    chown system system /sys/class/leds/green/blink
    chown system system /sys/class/leds/blue/blink
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    mkdir /dev/socket/netmgr 0750 radio radio

on late-fs
    mount_all /vendor/etc/fstab.qcom --late

on post-fs-data
    mkdir /data/vendor/camera 0770 camera camera
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    exec u:r:hal_bluetooth_default:s0 bluetooth bluetooth -- /vendor/bin/sh /vendor/etc/init.hp.bt-address.sh
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/radio 0770 system radio
    mkdir /data/vendor/netmgr 0770 radio radio
    mkdir /data/vendor/port_bridge 0770 radio radio
    mkdir /data/vendor/tombstones 0771 system system
    mkdir /data/vendor/tombstones/rfs 0771 system system
    mkdir /data/vendor/tombstones/rfs/modem 0771 system system
    mkdir /data/time 0700 system system
    write /data/vendor/radio/copy_complete 0
    chown radio radio /data/vendor/radio/copy_complete
    chmod 0660 /data/vendor/radio/copy_complete
    copy /vendor/radio/qcril_database/qcril.db /data/vendor/radio/qcril_prebuilt.db
    chown radio radio /data/vendor/radio/qcril_prebuilt.db
    chmod 0660 /data/vendor/radio/qcril_prebuilt.db
    write /data/vendor/radio/prebuilt_db_support 1
    chown radio radio /data/vendor/radio/prebuilt_db_support
    chmod 0400 /data/vendor/radio/prebuilt_db_support
    write /data/vendor/radio/db_check_done 0
    chown radio radio /data/vendor/radio/db_check_done
    chmod 0660 /data/vendor/radio/db_check_done
    exec u:r:vendor_init:s0 root radio -- /vendor/bin/sh /vendor/etc/init.hp.ril.sh
    setprop logd.logpersistd.size 2
    setprop logd.logpersistd logcatd

on property:persist.radio.multisim.config=dsds
    start vendor.ril-daemon2

on property:persist.radio.multisim.config=dsda
    start vendor.ril-daemon2

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

on property:wc_transport.start_hci=true
    start vendor.wcnss_filter

on property:wc_transport.start_hci=false
    stop vendor.wcnss_filter

service vendor.wcnss_filter /vendor/bin/wcnss_filter
    class hal
    user bluetooth
    group bluetooth system wakelock
    capabilities BLOCK_SUSPEND
    disabled

service vendor.qcamerasvr /vendor/bin/mm-qcamera-daemon
    class hal
    user camera
    group camera system inet input graphics

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root

service vendor.sensors /vendor/bin/sensors.qcom
    class core
    user root
    group root
    seclabel u:r:hal_sensors_default:s0
    disabled

service vendor.sensor-sh /vendor/bin/sh /vendor/etc/init.hp.sensors.sh
    class core
    user root
    seclabel u:r:vendor_init:s0
    oneshot

service vendor.irsc_util /vendor/bin/irsc_util "/vendor/etc/sec_config"
    class core
    user root
    seclabel u:r:rild:s0
    oneshot

service vendor.rmt_storage /vendor/bin/rmt_storage
    class core
    user root
    seclabel u:r:rild:s0
    shutdown critical
    ioprio rt 0

service vendor.tftp_server /vendor/bin/tftp_server
    class core
    user root
    seclabel u:r:rild:s0

service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system net_raw
    seclabel u:r:rild:s0
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    seclabel u:r:rild:s0
    disabled

service vendor.time_daemon /vendor/bin/time_daemon
    class late_start
    user root
    group root
    seclabel u:r:rild:s0
    disabled

service vendor.netmgrd /vendor/bin/netmgrd
    class main
    seclabel u:r:rild:s0

service vendor.ril-daemon2 /vendor/bin/hw/rild -c 2
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled

service wpa_supplicant /vendor/bin/hw/wpa_supplicant -O/data/vendor/wifi/wpa/sockets -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    class main
    user wifi
    group wifi inet keystore
    capabilities NET_ADMIN NET_RAW
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
