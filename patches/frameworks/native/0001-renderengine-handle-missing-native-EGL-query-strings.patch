From b3a267984383b939b154de5c8db648a78578e057 Mon Sep 17 00:00:00 2001
From: abobij <222517514+abobij@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:37:12 +0200
Subject: [PATCH 1/2] renderengine: handle missing native EGL query strings

Change-Id: I6f0875e1c6f88089ae902407372b16379e275708

diff --git a/libs/renderengine/gl/GLESRenderEngine.cpp b/libs/renderengine/gl/GLESRenderEngine.cpp
index d2a7525..7c09ea7 100644
--- a/libs/renderengine/gl/GLESRenderEngine.cpp
+++ b/libs/renderengine/gl/GLESRenderEngine.cpp
@@ -231,13 +231,32 @@ std::unique_ptr<GLESRenderEngine> GLESRenderEngine::create(int hwcFormat, uint32
                                                            uint32_t imageCacheSize) {
     // initialize EGL for the default display
     EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
-    if (!eglInitialize(display, nullptr, nullptr)) {
-        LOG_ALWAYS_FATAL("failed to initialize EGL");
+    EGLint eglMajor = 0;
+    EGLint eglMinor = 0;
+    if (!eglInitialize(display, &eglMajor, &eglMinor)) {
+        LOG_ALWAYS_FATAL("failed to initialize EGL: %#x", eglGetError());
+    }
+
+    const char* eglVersion = eglQueryStringImplementationANDROID(display, EGL_VERSION);
+    const EGLint versionError = eglGetError();
+    const char* eglExtensions = eglQueryStringImplementationANDROID(display, EGL_EXTENSIONS);
+    const EGLint extensionsError = eglGetError();
+    if (eglVersion == nullptr || eglExtensions == nullptr) {
+        ALOGW("EGL %d.%d driver query version=%s (%#x), extensions=%s (%#x)",
+              eglMajor, eglMinor, eglVersion ? "available" : "missing", versionError,
+              eglExtensions ? "available" : "missing", extensionsError);
+        if (eglVersion == nullptr) {
+            eglVersion = eglQueryString(display, EGL_VERSION);
+        }
+        if (eglExtensions == nullptr) {
+            eglExtensions = eglQueryString(display, EGL_EXTENSIONS);
+        }
+        LOG_ALWAYS_FATAL_IF(eglVersion == nullptr || eglExtensions == nullptr,
+                            "EGL display returned no version or extensions: %#x", eglGetError());
     }
 
     GLExtensions& extensions = GLExtensions::getInstance();
-    extensions.initWithEGLStrings(eglQueryStringImplementationANDROID(display, EGL_VERSION),
-                                  eglQueryStringImplementationANDROID(display, EGL_EXTENSIONS));
+    extensions.initWithEGLStrings(eglVersion, eglExtensions);
 
     // The code assumes that ES2 or later is available if this extension is
     // supported.
