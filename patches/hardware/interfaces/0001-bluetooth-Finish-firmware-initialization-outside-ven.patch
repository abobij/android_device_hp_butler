From e44c8030924b71a86a16577de8df21d027e204d4 Mon Sep 17 00:00:00 2001
From: abobij <222517514+abobij@users.noreply.github.com>
Date: Tue, 24 Nov 2026 05:38:13 +0200
Subject: [PATCH] bluetooth: Finish firmware initialization outside vendor op

Change-Id: I857d8916b75abb36801129e0305adca3c5b925b7

diff --git a/bluetooth/1.0/default/vendor_interface.cc b/bluetooth/1.0/default/vendor_interface.cc
index d56e344..aa080ab 100644
--- a/bluetooth/1.0/default/vendor_interface.cc
+++ b/bluetooth/1.0/default/vendor_interface.cc
@@ -268,6 +268,15 @@ bool VendorInterface::Open(InitializeCompleteCallback initialize_complete_cb,
   // Start configuring the firmware
   firmware_startup_timer_ = new FirmwareStartupTimer();
   lib_interface_->op(BT_VND_OP_FW_CFG, nullptr);
+  std::optional<uint8_t> pending_result;
+  {
+    std::lock_guard<std::mutex> lock(firmware_config_mutex_);
+    firmware_config_in_progress_ = false;
+    pending_result = pending_firmware_result_;
+  }
+  if (pending_result) {
+    FinishFirmwareConfiguration(*pending_result);
+  }
 
   return true;
 }
@@ -329,6 +338,18 @@ size_t VendorInterface::Send(uint8_t type, const uint8_t* data, size_t length) {
 void VendorInterface::OnFirmwareConfigured(uint8_t result) {
   ALOGD("%s result: %d", __func__, result);
 
+  {
+    std::lock_guard<std::mutex> lock(firmware_config_mutex_);
+    if (firmware_config_in_progress_) {
+      // Some vendor libraries invoke the callback with their op mutex held.
+      pending_firmware_result_ = result;
+      return;
+    }
+  }
+  FinishFirmwareConfiguration(result);
+}
+
+void VendorInterface::FinishFirmwareConfiguration(uint8_t result) {
   if (firmware_startup_timer_ != nullptr) {
     delete firmware_startup_timer_;
     firmware_startup_timer_ = nullptr;
diff --git a/bluetooth/1.0/default/vendor_interface.h b/bluetooth/1.0/default/vendor_interface.h
index 1d69040..542f21d 100644
--- a/bluetooth/1.0/default/vendor_interface.h
+++ b/bluetooth/1.0/default/vendor_interface.h
@@ -18,6 +18,9 @@
 
 #include <hidl/HidlSupport.h>
 
+#include <mutex>
+#include <optional>
+
 #include "async_fd_watcher.h"
 #include "bt_vendor_lib.h"
 #include "hci_protocol.h"
@@ -54,6 +57,7 @@ class VendorInterface {
             PacketReadCallback sco_cb);
   void Close();
 
+  void FinishFirmwareConfiguration(uint8_t result);
   void OnTimeout();
 
   void HandleIncomingEvent(const hidl_vec<uint8_t>& hci_packet);
@@ -66,6 +70,9 @@ class VendorInterface {
 
   PacketReadCallback event_cb_;
 
+  std::mutex firmware_config_mutex_;
+  bool firmware_config_in_progress_ = true;
+  std::optional<uint8_t> pending_firmware_result_;
   FirmwareStartupTimer* firmware_startup_timer_ = nullptr;
 };
 
